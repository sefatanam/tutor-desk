# ─── Nginx Virtual Host Template ──────────────────────────────────────────────
# Generated by add-vhost.sh for each customer.
# Certbot will append SSL configuration below the server block automatically.
# ──────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    server_name CUSTOMER_DOMAIN;

    # Proxy /api/* → Go API container
    location /api/ {
        proxy_pass         http://127.0.0.1:API_PORT;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 60M;
    }

    # Proxy /uploads/* → Go API (file serving)
    location /uploads/ {
        proxy_pass         http://127.0.0.1:API_PORT;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_cache_valid  200 1d;
        add_header         Cache-Control "public, max-age=86400";
    }

    # Proxy /swagger/* → Go API Swagger UI
    location /swagger/ {
        proxy_pass         http://127.0.0.1:API_PORT;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
    }

    # All other requests → Angular SSR web server
    location / {
        proxy_pass         http://127.0.0.1:WEB_PORT;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
    gzip_min_length 1000;
}
