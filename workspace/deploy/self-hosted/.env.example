# ─── TutorDesk Self-Hosted Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values, then run setup.sh
# ──────────────────────────────────────────────────────────────────────────────

# ── Docker Images (provided by TutorDesk) ────────────────────────────────────
DOCKER_IMAGE_API=yourdockerhub/tutordesk-api
DOCKER_IMAGE_WEB=yourdockerhub/tutordesk-web
APP_VERSION=v1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=tutordesk
DB_USER=tutordesk
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# ── Application ───────────────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS
CORS_ORIGINS=https://yourdomain.com

# Ports exposed on the host machine
API_PORT=8080
WEB_PORT=3000

# ── bKash Payment Gateway (optional) ─────────────────────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://yourdomain.com/payment/callback
