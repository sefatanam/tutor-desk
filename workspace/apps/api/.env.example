# =============================================
# TUTOR DESK API - Environment Variables
# Copy this file to .env and fill in values
# =============================================

# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker PostgreSQL (default when using docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tutordesk?sslmode=disable

# Supabase cloud connection string (use during migration transition)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── Authentication ───────────────────────────────────────────────────────────
# CRITICAL: Must match the JWT_SECRET used by existing Supabase Edge Functions
# so Angular tokens remain valid during the migration transition.
# In Supabase: Settings > Edge Functions > Secrets > TD_JWT_SECRET
JWT_SECRET=tutor-desk-super-secret-key-change-in-production-2024

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Absolute path or path relative to the binary.
# The directory is created automatically on startup.
# Default "../../uploads" resolves to workspace/uploads/ when binary is at apps/api/
UPLOAD_DIR=../../uploads
