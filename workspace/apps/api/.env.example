# =============================================
# TUTOR DESK API - Environment Variables
# Copy this file to .env and fill in values
# =============================================

# ─── Core ─────────────────────────────────────────────────────────────────────
# Local Docker PostgreSQL (default when using docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tutordesk?sslmode=disable
# Production PostgreSQL (example)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@your-host:5432/tutordesk

JWT_SECRET=tutor-desk-super-secret-key-change-in-production-2024
PORT=8080
ENV=development

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:4200

# Path for uploaded learning assets (relative to binary or absolute)
UPLOAD_DIR=../../uploads

# ─── Server Timeouts (seconds) ────────────────────────────────────────────────
SERVER_READ_TIMEOUT_S=30
SERVER_WRITE_TIMEOUT_S=60
SERVER_IDLE_TIMEOUT_S=120
SERVER_SHUTDOWN_TIMEOUT_S=10

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRY_S=900        # 15 minutes
JWT_REFRESH_EXPIRY_S=604800    # 7 days
BCRYPT_COST=12                 # bcrypt work factor (10–14 recommended; higher = slower)

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ─── Database Pool ────────────────────────────────────────────────────────────
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_M=30      # minutes
DB_MAX_CONN_IDLE_TIME_M=5      # minutes
DB_HEALTH_CHECK_PERIOD_M=1     # minutes

# ─── bKash Payment Gateway ────────────────────────────────────────────────────
# Sandbox:    https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_app_key
BKASH_APP_SECRET=your_app_secret
BKASH_USERNAME=your_username
BKASH_PASSWORD=your_password
BKASH_CALLBACK_URL=http://localhost:4200/payment/callback
BKASH_HTTP_TIMEOUT_S=30
