# ─── Stage 1: Build ───────────────────────────────────────────────────────────
# Builds the Angular SSR app using the full Nx monorepo workspace.
# Context must be set to the workspace root (same as api Dockerfile).
FROM node:22-alpine AS builder

WORKDIR /workspace

# Copy dependency manifests first for layer caching
COPY package*.json ./
RUN npm ci --prefer-offline

# Copy the entire workspace (Nx needs the full tree)
COPY . .

# Build production SSR bundle
RUN npx nx build web --configuration=production

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Copy built SSR output from builder
COPY --from=builder /workspace/dist/apps/web ./

EXPOSE 4000

# Angular SSR server entry point generated by @angular/build
CMD ["node", "server/server.mjs"]
